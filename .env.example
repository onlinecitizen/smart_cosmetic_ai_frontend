# Copy to .env.local for local development. Never commit a real .env.local.
#
# Base URL of the backend API. This is a NEXT_PUBLIC_ variable, so it is
# baked in at build time - changing it requires a new build/deploy.
# Local dev default: http://localhost:8000
# On Netlify, set this to the deployed backend's URL (Site configuration ->
# Environment variables) and trigger a new deploy after changing it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
